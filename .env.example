NODE_ENV=development
PORT=4000

# Local dev / docker-compose value. On Railway, use the **internal**
# DATABASE_URL Railway's Postgres plugin provides (looks like
# postgresql://user:pass@postgres.railway.internal:5432/railway), never the
# **public** one (a *.proxy.rlwy.net host) — the internal URL only resolves
# inside Railway's private network between your services, so it's both
# faster (no trip out to the public internet and back) and not exposed to
# the open internet the way the public/proxy URL is. Railway shows both in
# the Postgres plugin's "Connect" tab, clearly labeled; the public one exists
# for connecting from your own laptop (e.g. via `psql`), not for your app's
# own DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_portal?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# The externally-reachable base URL for this API, used only as the `servers`
# entry in the generated OpenAPI spec (/api/openapi.json, /api/docs) — not
# used for anything else. Leave as localhost for local dev; set to the real
# public URL (e.g. https://your-app.up.railway.app) in every deployed
# environment, or the docs will show the wrong host to call.
PUBLIC_BASE_URL=http://localhost:4000

# Whether GET /api/docs and GET /api/openapi.json are mounted at all.
# Unset by default: defaults to enabled everywhere except NODE_ENV=production
# (the generated spec's `x-roles` on every operation is a complete
# authorization map of the API — not something to leave publicly reachable
# in production by default). Set explicitly (true/false) to override that
# default in either direction.
# DOCS_ENABLED=true

# Comma-separated allowlist of origins the API's CORS policy accepts, e.g.
# CORS_ORIGINS=https://app.example.com,https://staff.example.com
# Optional in development/test (unset = allow any origin, matching a plain
# cors() with no config). **Required in production** — the server refuses
# to start otherwise (see src/config/env.ts). Railway issues a distinct URL
# per environment (each preview deploy, staging, production), so this
# commonly needs more than one entry once a frontend is deployed there too.
# CORS_ORIGINS=
