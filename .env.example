NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_portal?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# The externally-reachable base URL for this API, used only as the `servers`
# entry in the generated OpenAPI spec (/api/openapi.json, /api/docs) — not
# used for anything else. Leave as localhost for local dev; set to the real
# public URL (e.g. https://your-app.up.railway.app) in every deployed
# environment, or the docs will show the wrong host to call.
PUBLIC_BASE_URL=http://localhost:4000
