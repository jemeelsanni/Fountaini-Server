NODE_ENV=test
PORT=4001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_portal_test?schema=public

JWT_ACCESS_SECRET=test-only-insecure-jwt-secret-do-not-use-in-production-00000000
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Explicit, not relying on this key's own "console" default: src/config/
# env.ts's `import "dotenv/config"` loads the root .env (via dotenv's
# default cwd-relative path) as a side effect of importing env.ts itself,
# which happens *after* vitest.setup.ts's explicit .env.test.local/.env.test
# loads above but *before* env.ts's schema actually reads process.env.
# dotenv never overwrites an already-set var, so any var this file (or
# .env.test.local) doesn't define falls through to whatever the developer's
# own .env happens to have — which, for NOTIFICATION_PROVIDER/
# RESEND_API_KEY, was silently "resend" + a real API key, sending real
# email through the test suite and burning real Resend quota on every run.
# Setting it here closes that specific leak by winning the race outright.
NOTIFICATION_PROVIDER=console
